# ---- Environment ----
# local | development | staging | production
APP_ENV=local
# development for local and development; production for staging and production
NODE_ENV=development
PORT=3000

# ---- Shopify app (use a SEPARATE Shopify app for each environment) ----
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
# Your host, without https:// (for local: your dev tunnel host)
APP_HOST=your-app-host-without-protocol.com

# ---- Database (DB_PASSWORD is required on staging and production) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dr_delivery_date

# ---- Token encryption (AES-256-GCM, 32-byte base64 key) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT key in every environment.
TOKEN_ENCRYPTION_KEY=generate_with_command_above
TOKEN_ENCRYPTION_KEY_ID=v1
# OLD keys, only for reading tokens saved before a rotation. Leave empty if you never rotated.
# Format: v1=base64key,v0=base64key
TOKEN_ENCRYPTION_OLD_KEYS=

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- HTTP ----
CORS_ORIGINS=

# How many proxies / load balancers stand between the internet and this server.
# 0 = none (your laptop). 1 = one (for example a load balancer, or a Cloudflare/ngrok tunnel).
# Wrong values break rate limiting.
TRUST_PROXY=0

# ---- Staff login and support access ----
# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Every environment needs its OWN values, and all secrets must be different from each other.
STAFF_SESSION_SECRET=
SUPPORT_TOKEN_SECRET=
# true = staff must use a 2FA code. "false" is allowed ONLY when APP_ENV=local.
# Locally, if the 2FA code is annoying while you build, you can set STAFF_REQUIRE_2FA=false. It is refused on every other environment.
STAFF_REQUIRE_2FA=true
# The staff login (and every support session) ends this many minutes after login (5 to 480).
STAFF_SESSION_MINUTES=30
# Address of your frontend. Origin only, no path. Local: http://localhost:5173
# APP_FRONTEND_URL must be your real frontend address on each server, and it must use https on staging and production.
APP_FRONTEND_URL=http://localhost:5173
# Optional. Comma separated IPs that may use /internal. Empty = no limit.
STAFF_ALLOWED_IPS=