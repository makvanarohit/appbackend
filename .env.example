# local | development | staging | production
APP_ENV=local
# development for local and development servers; production for staging and production
NODE_ENV=development
PORT=3000

SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
STANDALONE_TOKEN_SECRET=generate_with_command_below
STANDALONE_TOKEN_TTL_DAYS=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=delivery_date_app

# 32-byte key, base64-encoded, used to encrypt tokens at rest (AES-256-GCM).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ACTIVE key: encrypts all new tokens. Change the id when you change the key (v1 -> v2).
TOKEN_ENCRYPTION_KEY=generate_with_command_above
TOKEN_ENCRYPTION_KEY_ID=v1
# OLD keys, only for reading tokens saved before a rotation. Leave empty if you never rotated.
# Format: v1=base64key,v0=base64key
TOKEN_ENCRYPTION_OLD_KEYS=

APP_HOST=your-app-host-without-protocol.com
REDIS_URL=redis://127.0.0.1:6379

CORS_ORIGINS=

# How many proxies / load balancers stand between the internet and this server.
# 0 = none (your laptop). 1 = one (for example a load balancer, or a Cloudflare/ngrok tunnel).
# Wrong values break rate limiting.
TRUST_PROXY=0