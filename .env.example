# ============================================
# Frontend Environment Variables
# Copy this to .env.development or .env.production
# and fill in your values
# NEVER commit .env.development or .env.production
# ============================================

# Get this from Shopify Partner Dashboard
# Apps → Your App → App setup → Client ID
VITE_SHOPIFY_API_KEY=your_client_id
VITE_FORCE_STANDALONE=false

# Backend URL
# Development: http://localhost:3000
# Production: https://your-backend-domain.com
VITE_BACKEND_URL=http://localhost:3000

# Environment: local | development | staging | production
VITE_APP_ENV=local